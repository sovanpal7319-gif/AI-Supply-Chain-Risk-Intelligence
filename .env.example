# ──────────────────────────────────────────────────────────
# Supply Chain Disruption Monitor — Environment Variables
# ──────────────────────────────────────────────────────────

# ── Groq LLM (REQUIRED — free at console.groq.com) ───────
GROQ_API_KEY=gsk_your-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# ── NewsAPI (REQUIRED — free at newsapi.org/register) ─────
NEWS_API_KEY=your-newsapi-key-here

# ── Neo4j (REQUIRED) ─────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ── RL Decision Agent ──────────────────────────────────────
USE_RL_DECISION=true

# ── Dynamic Graph Pipeline ─────────────────────────────────
# 'mock' = curated dataset, 'llm' = Groq LLM generates ecosystems
ENRICHMENT_MODE=mock

# ── GraphSAGE Risk Prediction ──────────────────────────────
USE_GRAPHSAGE=true
GRAPHSAGE_MODEL_PATH=models/graphsage_risk.pt
GRAPHSAGE_HIDDEN_DIM=64
GRAPHSAGE_BLEND_WEIGHT=0.70

# ── Fine-tuned BERT Model (optional) ──────────────────────
# BERT_MODEL_PATH=models/bert_supply_chain_final.pt
# BERT_TOKENIZER_PATH=models/bert_supply_chain_tokenizer
# BERT_CONFIDENCE_THRESHOLD=0.8

# ── Server Configuration ──────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
